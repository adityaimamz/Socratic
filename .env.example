# Supabase hosted. Salin file ini menjadi .env.local, lalu isi nilainya.
# Tidak memerlukan Docker, PostgreSQL lokal, atau password database.

# Project URL dari proyek Supabase, contoh: https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Boleh digunakan oleh browser untuk Auth.
# Jika proyek masih memakai key legacy, isi dengan anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Khusus server; jangan gunakan awalan NEXT_PUBLIC_.
# Jika proyek masih memakai key legacy, isi dengan service_role key.
SUPABASE_SECRET_KEY=

# Origin aplikasi. Gunakan URL ini saat membuka aplikasi lokal.
# Saat deployment, ganti dengan URL HTTPS aplikasi yang sebenarnya.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Email yang akan didaftarkan sebagai admin pertama (Google atau email/password).
BOOTSTRAP_ADMIN_EMAIL=

# Opsional, hanya untuk menerapkan migrasi lewat Management API Supabase.
# Personal access token dari akun Supabase; berbeda dari secret key aplikasi.
# Tidak diperlukan untuk menjalankan aplikasi setelah migrasi selesai.
SUPABASE_ACCESS_TOKEN=
